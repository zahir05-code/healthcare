# 카카오 API 키 설정
# Kakao Developers (https://developers.kakao.com)에서 앱 등록 후 키를 입력하세요.

# JavaScript 키 (카카오 로그인, 공유, 카카오맵용)
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key_here

# 카카오맵 JavaScript 키 (카카오맵 전용, 같은 앱의 키 사용 가능)
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_map_key_here

# REST API 키 (서버 사이드 알림톡용 - 선택사항)
# KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
